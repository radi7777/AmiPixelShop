{
  "1": { "class_type": "CheckpointLoaderSimple", "_meta": { "title": "Any SD 1.5 / SDXL inpainting checkpoint (models/checkpoints)" },
         "inputs": { "ckpt_name": "YOUR_INPAINTING_MODEL.safetensors" } },
  "2": { "class_type": "CLIPTextEncode", "inputs": { "text": "%prompt%", "clip": ["1", 1] } },
  "3": { "class_type": "CLIPTextEncode", "inputs": { "text": "blurry, low quality, watermark, text, frame", "clip": ["1", 1] } },
  "4": { "class_type": "LoadImage", "_meta": { "title": "Image from AmiPixelShop (transparent = fill)" },
         "inputs": { "image": "%image%" } },
  "5": { "class_type": "VAEEncodeForInpaint",
         "inputs": { "pixels": ["4", 0], "vae": ["1", 2], "mask": ["4", 1], "grow_mask_by": 8 } },
  "6": { "class_type": "KSampler",
         "inputs": { "model": ["1", 0], "seed": "%seed%", "steps": 25, "cfg": 7.0,
                     "sampler_name": "dpmpp_2m", "scheduler": "karras",
                     "positive": ["2", 0], "negative": ["3", 0], "latent_image": ["5", 0], "denoise": 1.0 } },
  "7": { "class_type": "VAEDecode", "inputs": { "samples": ["6", 0], "vae": ["1", 2] } },
  "8": { "class_type": "SaveImage", "inputs": { "images": ["7", 0], "filename_prefix": "AmiPixelShop" } }
}
